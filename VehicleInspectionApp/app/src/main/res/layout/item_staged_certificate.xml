<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/cert_item_bg">

    <!-- Left: type name + dates/error -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemCertTypeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#1A237E"
            android:text="" />

        <TextView
            android:id="@+id/itemCertDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#607D8B"
            android:layout_marginTop="3dp"
            android:text="" />

    </LinearLayout>

    <!-- Status chip (pill badge) -->
    <TextView
        android:id="@+id/itemCertStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="#A2A2A2"
        android:text="Pending" />

    <!-- Delete / remove button -->
    <ImageButton
        android:id="@+id/itemCertDeleteBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:src="@drawable/error_step"
        android:tint="#D32F2F"
        android:contentDescription="Remove" />

</LinearLayout>
