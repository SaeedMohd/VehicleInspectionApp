<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="28dp"
    android:elevation="12dp"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:maxHeight="560dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="36dp"
            android:paddingBottom="32dp">

            <!-- Icon in soft red circle -->
            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/dialog_icon_bg_error"
                android:padding="16dp"
                android:src="@drawable/error_step"
                android:scaleType="fitCenter"
                app:tint="#C62828" />

            <!-- Title (overridable by code for validation errors) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Oops!"
                android:textColor="#212121"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Dynamic error message -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text=""
                android:textColor="#757575"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.4" />

            <Button
                android:id="@+id/btnAction"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/btn_dialog_error"
                android:text="OK"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                app:backgroundTint="@null" />

        </LinearLayout>

    </ScrollView>

</androidx.cardview.widget.CardView>
