<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">
    
    
<EditText
        android:id="@+id/changePasswordOldPasswordEditText"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="4dp"
        android:hint="Enter old password" />

    <EditText
        android:id="@+id/changePasswordNewPasswordEditText"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="4dp"
        android:hint="Enter new password" />

    <EditText
        android:id="@+id/changePasswordConfirmNewPasswordEditText"
        android:inputType="textPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="4dp"
        android:hint="Confirm new password" />

<LinearLayout 
    android:id="@+id/changePasswordProgressLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_gravity="center"
    android:visibility="invisible"
    >
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Please Wait..."
        android:layout_gravity="center"
        />
    
    <ProgressBar 
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_marginStart="10dp"
        />
    
</LinearLayout>

<Button
    android:id="@+id/changePasswordDialogChangePasswordButton"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="25dp"
    android:paddingStart="25dp"
    android:text="Change Password"
    android:layout_gravity="center"
    android:background="@drawable/btn_cert_primary"
    android:textColor="@color/white"
    app:backgroundTint="@null"
    android:layout_marginBottom="10dp"
    />

</LinearLayout>
