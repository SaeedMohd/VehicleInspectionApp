                        android:layout_column="0"
                        android:textStyle="bold"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editClubCHeck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="Club Hub/MRM"
                        android:textStyle="bold"
                        android:layout_column="1"
                        app:buttonTint="@drawable/checkbox_bkg"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editCommCHeck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="eComm"
                        android:textStyle="bold"
                        android:layout_column="2"
                        app:buttonTint="@drawable/checkbox_bkg"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editEnvCheck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="Envision"
                        android:textStyle="bold"
                        android:layout_column="3"
                        app:buttonTint="@drawable/checkbox_bkg"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editModCheck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="MOD"
                        android:textStyle="bold"
                        app:buttonTint="@drawable/checkbox_bkg"
                        android:layout_column="4"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editIrasCheck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="IRAS"
                        android:textStyle="bold"
                        android:layout_column="5"
                        app:buttonTint="@drawable/checkbox_bkg"
                        />
                    <CheckBox
                        android:layout_width="wrap_content"
                        android:id="@+id/editRspCheck"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_margin="5dp"
                        android:text="RSP"
                        android:textStyle="bold"
                        android:layout_column="6"
                        app:buttonTint="@drawable/checkbox_bkg"
                        />
                </TableRow>
            </TableLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>




    <RelativeLayout
        android:id="@+id/photosPreviewDialog"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_centerInParent="true"
        android:background="#F0F4FF"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/photosPreviewImageView"
            android:layout_width="wrap_content"
            android:layout_centerInParent="true"
            android:layout_height="270dp"
            android:scaleType="fitXY"/>

        <Button
            android:id="@+id/photosPreviewDialogCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/btn_cert_primary"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:paddingEnd="15dp"
            android:paddingStart="15dp"
            android:layout_marginTop="10dp"
            android:text="Close"
            android:layout_below="@id/photosPreviewImageView"

            />

    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:layout_margin="50dp"
        app:cardCornerRadius="5dp"
        android:id="@+id/photosEnlargeDialog"
        android:visibility="gone"
        android:background="@drawable/black_border"
        app:cardElevation="10dp">

        <ImageView
            android:id="@+id/photosEnlargeImageView"
            android:layout_width="wrap_content"
            android:layout_centerInParent="true"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/profile_photo"
            />
        <ImageView
            android:id="@+id/closeImageView"
            android:layout_width="20dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_gravity="top|right"
            android:layout_height="20dp"
            android:layout_margin="10dp"
            android:background="@drawable/close"
            android:scaleType="fitXY"/>
        />



    </androidx.cardview.widget.CardView>

    <RelativeLayout
        android:id="@+id/photoLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:clickable="true"
        android:background="#1A237E"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBarRecordsPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecordsPhotos"
            android:layout_centerHorizontal="true"
            android:id="@+id/progressBarText"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

    </RelativeLayout>
</RelativeLayout>