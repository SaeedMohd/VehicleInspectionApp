<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/dialog_bkg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/dialogTitle"
            android:text="Speech Recognition Dialog"
            android:layout_weight="2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:layout_width="200dp"
            android:id="@+id/dialogSaveBtn"
            android:padding="10dp"
            android:background="@drawable/btn_cert_primary"
            android:textColor="@color/white"
            android:layout_height="wrap_content"
            app:backgroundTint="@null"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_gravity="center_vertical"
            android:text="Save Notes"
            android:enabled="false"
            />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:id="@+id/dialogCloseBtn"
            android:layout_marginStart="10dp"
            android:background="@drawable/close"
            />
    </LinearLayout>



    <!-- Live Transcription -->
    <androidx.cardview.widget.CardView
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/listeningText"
                android:text="Listening..."
                android:textSize="24sp"
                android:textColor="#26C3AA"
                android:layout_marginBottom="20dp"
                android:textStyle="bold|italic"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dashboard_border"
                    android:gravity="center_vertical"
                    android:minHeight="200dp"
                    android:orientation="horizontal">
        <TextView
            android:id="@+id/tvSpeechText"
            android:layout_margin="20dp"
            android:textSize="18sp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#000"
            android:maxLines="10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            />
        <ImageView
            android:layout_width="24dp"
            android:id="@+id/saveSpeechBtn"
            android:layout_height="24dp"
            android:visibility="gone"
            android:scaleType="fitXY"
            android:layout_margin="10dp"
            android:src="@drawable/save_icon"
            android:background="@drawable/save_icon"
            android:backgroundTintMode="multiply"
            android:backgroundTint="#4572CE"
            />
    </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieWave"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:visibility="gone"
        app:lottie_rawRes="@raw/voice_wave"
        app:lottie_autoPlay="false"
        app:lottie_loop="true" />

    <!-- Buttons Row -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- Start Recording -->
        <ImageView
            android:id="@+id/btnStart"
            android:src="@drawable/mic_icon"
            android:visibility="gone"
            android:padding="10dp"
            android:layout_width="60dp"
            android:layout_height="60dp"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/btnHoldToTalk"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:padding="10dp"
            app:lottie_rawRes="@raw/mic_press"
            app:lottie_autoPlay="false"
            app:lottie_loop="false" />
    </LinearLayout>

</LinearLayout>