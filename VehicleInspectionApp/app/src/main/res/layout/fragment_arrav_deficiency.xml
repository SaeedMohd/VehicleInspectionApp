<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context=".fragments.FragmentARRAVDeficiency">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Deficiency card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Header -->
                <RelativeLayout
                    android:id="@+id/subTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/deffTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Deficiency"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Filter row -->
                <RadioGroup
                    android:id="@+id/loadDefRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/filteredDefRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:checked="true"
                        android:text="Deficiencies with no cleared date"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/allDefRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Deficiencies"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </RadioGroup>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/loadDefButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_cert_outline"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Load Deficiencies"
                        android:textAllCaps="false"
                        android:textColor="#4572CE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/showNewDeffDialogueBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Add New Deficiency"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Deficiency table -->
                <TableLayout
                    android:id="@+id/DeffResultsTbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:showDividers="middle"
                    android:shrinkColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="36dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Deficiency"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Visitation Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Entered Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Due Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Cleared Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="5"
                            android:layout_weight="1.4"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Comments"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="6"
                            android:layout_weight="0.6"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Options"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

            </LinearLayout>

            <!-- Deficiency Actions card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:background="#1565C0" />
                    <TextView
                        android:id="@+id/deffTitle2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deficiency Actions"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TableLayout
                    android:id="@+id/actionsTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:showDividers="middle"
                    android:shrinkColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="36dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Action"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Action Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Due Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay -->
    <View
        android:id="@+id/visitationFormAlphaBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:visibility="gone" />

    <!-- Add New Deficiency dialog -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/defeciencyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Add New Deficiency"
                        android:textColor="#1A237E"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/exitDeffeciencyDialogeBtnId"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <!-- Deficiency -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Deficiency *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/newDefSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Visitation Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Visitation Date *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/newVisitationDateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Cleared Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Cleared Date"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/newClearedDateBtn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/comments_editTextVal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxEms="250"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <!-- Submit -->
                <Button
                    android:id="@+id/submitNewDeffNewBtn"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_primary"
                    android:text="SUBMIT"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Edit Deficiency dialog -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/defeciencyCardEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Edit Deficiency"
                        android:textColor="#1A237E"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/exitDeffeciencyDialogeBtnIdEdit"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <!-- Deficiency -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Deficiency *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/newDefSpinnerEdit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Visitation Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Visitation Date *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/newVisitationDateBtnEdit"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Cleared Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Cleared Date"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/newClearedDateBtnEdit"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/comments_editTextValEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxEms="250"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <!-- Submit -->
                <Button
                    android:id="@+id/submitNewDeffNewBtnEdit"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_primary"
                    android:text="SUBMIT"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/DeffLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="#4572CE"
                    app:trackColor="#EEF2FB"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/progressBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="#1A237E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</RelativeLayout>
