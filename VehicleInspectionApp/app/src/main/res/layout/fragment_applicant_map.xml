<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F4FF">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/frame_solid_border"
        android:orientation="horizontal">
        <RadioGroup
            android:id="@+id/rgHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rgSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Search Shops"
                android:textSize="14sp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rgLoad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Load Saved Shops"
                android:textSize="14sp"
                android:layout_marginStart="16dp"/>
        </RadioGroup>
        <Button
            android:id="@+id/startBtn"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical|end"
            android:text="Start"
            android:textColor="@color/white"
            android:background="@drawable/btn_cert_primary" />
    </LinearLayout>

        <!-- ================= FILTER SECTION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:id="@+id/ll_search"
            android:visibility="gone"
            android:background="@drawable/frame_solid_border"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Search Option"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"/>

            <RadioGroup
                android:id="@+id/rgFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rgNearBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search By Nearby"
                    android:textSize="14sp"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rgText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search By Text"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"/>
            </RadioGroup>

            <!-- Radius Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/slider_ll"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Radius:"
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"/>

                <com.google.android.material.slider.Slider
                    android:id="@+id/radiusSlider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:valueFrom="1"
                    android:valueTo="50"
                    android:stepSize="1"
                    android:value="1"
                    app:labelBehavior="gone"
                    app:trackColor="@color/mainColor"
                    android:layout_marginStart="10dp"/>
                <EditText
                    android:layout_width="100dp"
                    android:inputType="number"
                    android:digits="0123456789"
                    android:id="@+id/radiusET"
                    android:text="1"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:lines="1"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:id="@+id/text_ll"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search:"
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/searchText"
                    android:layout_width="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:layout_weight="1"
                    android:layout_column="1"
                    android:background="@drawable/cert_input_background"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Radius Value + Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:layout_marginTop="0dp">

                <RadioGroup
                    android:id="@+id/rgClearFlags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rgClear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add to Current List"
                        android:textSize="14sp"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rgClearALL"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear All Shops"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>

                <Button
                    android:id="@+id/searchMapBtn"
                    android:layout_width="150dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:text="Search"
                    android:textColor="@color/white"
                    android:background="@drawable/new_btn_bkg"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= RESULTS + MAP SECTION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:padding="10dp"
            android:id="@+id/ll_results"
            android:visibility="gone"
            android:background="@drawable/frame_solid_border"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- RecyclerView -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/placesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="true"
                    android:clipToPadding="false"
                    android:scrollbars="vertical"/>
            </LinearLayout>

            <!-- Map -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <fragment
                    android:id="@+id/mapFragment"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="600dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>