<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:orientation="vertical"
    android:background="@color/transparent"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/failed_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:src="@drawable/failed_step" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/success_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:src="@drawable/success_step" />

        <TextView
            android:id="@+id/step_circle_text"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="visible"
            android:background="@drawable/step_circle_in_progress"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/step_progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:indeterminateTint="#1565C0"
            android:indeterminate="true"
            style="?android:attr/progressBarStyle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@color/transparent"
            android:paddingStart="16dp">

            <TextView
                android:id="@+id/step_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 1:"
                android:textColor="#1A237E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/step_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Step Status"
                android:textColor="#546878"
                android:textIsSelectable="true"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/step_line"
        android:layout_width="2dp"
        android:layout_height="18dp"
        android:layout_marginStart="19dp"
        android:layout_marginTop="2dp"
        android:background="#DDE6F5" />

</LinearLayout>
