<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.inspection.fragments.FacilityGeneralInformationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F4FF"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/mainViewLinearId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hidden test button (keep for code compatibility) -->
            <Button
                android:id="@+id/testBtnId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="test"
                android:visibility="gone" />

            <!-- ── Card 1: AAR/RSP Addendum ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AAR/RSP Addendum"
                    android:textColor="#1565C0"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E0E0E0" />

                <!-- Row 1: Start Date | End Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Date"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background">

                            <Button
                                android:id="@+id/addstartDateButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="SELECT DATE"
                                android:textAllCaps="false"
                                android:textColor="#4572CE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@null" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End Date"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background">

                            <Button
                                android:id="@+id/addendDateButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="SELECT DATE"
                                android:textAllCaps="false"
                                android:textColor="#4572CE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@null" />
                        </RelativeLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2: Addendum Signed Date | Number of Card Readers -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Addendum Signed Date"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background">

                            <Button
                                android:id="@+id/addsignDateButton"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:text="SELECT DATE"
                                android:textAllCaps="false"
                                android:textColor="#4572CE"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:backgroundTint="@null" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Number of Card Readers"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/addnumberOfCardsReaderEditText"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:inputType="number"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1A237E"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Save / Cancel buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/addcancelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_cert_outline"
                        android:enabled="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#4572CE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/addsaveButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/btn_cert_primary"
                        android:enabled="false"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Save"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Card 2: RSP Tracking ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="16dp">

                <!-- Section header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="RSP Tracking"
                        android:textColor="#1565C0"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/addNewAarButton"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="+ Add RSP Tracking"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E0E0E0" />

                <TableLayout
                    android:id="@+id/aarPortalTrackingTableLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_table_layout"
                    android:showDividers="middle"
                    android:stretchColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="40dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Portal Inspection Date"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Logged Into Portal"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Unacknowledged Tows"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="In Progress Tows"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="In Progress Walk-ins"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="5"
                            android:layout_weight="0.6"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Update"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </TableRow>

                </TableLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay -->
    <View
        android:id="@+id/alphaBackgroundForRSPDialogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:background="@color/mainColor"
        android:visibility="gone" />

    <!-- ── Add RSP Tracking dialog ── -->
    <ScrollView
        android:id="@+id/Add_AAR_PortalTrackingEntryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Add New RSP Tracking"
                        android:textColor="#1A237E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/submitNewAAR_PortalTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="36dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <ImageButton
                        android:id="@+id/exitRSPDialogeBtnId"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="@null" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Inspection Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inspection Date"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/cert_input_background">

                    <Button
                        android:id="@+id/inspectionDateButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:text="SELECT DATE"
                        android:textAllCaps="false"
                        android:textColor="#4572CE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </RelativeLayout>

                <!-- Row: Unacknowledged | In Progress Tow-Ins -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unacknowledged Records"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/numberOfUnacknowledgedRecordsEditText"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:inputType="number"
                            android:nextFocusDown="@id/numberOfInProgressTwoIns"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1A237E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In-Progress Tow-Ins"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/numberOfInProgressTwoIns"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:inputType="number"
                            android:nextFocusDown="@id/numberOfInProgressWalkIns"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1A237E"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- In-Progress Walk-Ins -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In-Progress Walk-Ins"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/numberOfInProgressWalkIns"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="center"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#1A237E"
                    android:textSize="13sp" />

                <!-- Logged Into RSP -->
                <CheckBox
                    android:id="@+id/loggedIntoRspButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Logged Into RSP"
                    android:textColor="#1A237E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:buttonTint="@drawable/checkbox_bkg" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- ── Edit RSP Tracking dialog ── -->
    <ScrollView
        android:id="@+id/edit_AAR_PortalTrackingEntryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Update RSP Tracking"
                        android:textColor="#1A237E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/edit_submitNewAAR_PortalTracking"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="36dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <ImageButton
                        android:id="@+id/edit_exitRSPDialogeBtnId"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="@null" />

                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Inspection Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inspection Date"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/cert_input_background">

                    <Button
                        android:id="@+id/edit_inspectionDateButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="SELECT DATE"
                        android:textAllCaps="false"
                        android:textColor="#4572CE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </RelativeLayout>

                <!-- Row: Unacknowledged | In Progress Tow-Ins -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unacknowledged Records"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/edit_numberOfUnacknowledgedRecordsEditText"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:inputType="number"
                            android:nextFocusDown="@id/edit_numberOfInProgressTwoIns"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1A237E"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="In-Progress Tow-Ins"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/edit_numberOfInProgressTwoIns"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:inputType="number"
                            android:nextFocusDown="@id/edit_numberOfInProgressWalkIns"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="#1A237E"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- In-Progress Walk-Ins -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In-Progress Walk-Ins"
                    android:textColor="#37474F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_numberOfInProgressWalkIns"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="center"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="#1A237E"
                    android:textSize="13sp" />

                <!-- Logged Into RSP -->
                <CheckBox
                    android:id="@+id/edit_loggedIntoRspButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Logged Into RSP"
                    android:textColor="#1A237E"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:buttonTint="@drawable/checkbox_bkg" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- ── aaraddanTableLayout (keep ID for code) ── -->
    <TableLayout
        android:id="@+id/aaraddanTableLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Loading overlay -->
    <RelativeLayout
        android:id="@+id/RSP_LoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:clickable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBarRecordsSPA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:id="@+id/rspLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecordsSPA"
            android:layout_centerHorizontal="true"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>
