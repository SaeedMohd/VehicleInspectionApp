<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".fragments.FragmentAARAVBilling">

    <HorizontalScrollView
        android:id="@+id/facilityGroupButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/white"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/generalInformationButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="General Information"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/generalInformationSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/vehicleServicesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Vehicle Services"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/vehicleServicesSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/programsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Programs"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/programsSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/facilityServicesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Facility Services"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/facilityServicesSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/vehiclesButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Vehicles"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/vehiclesSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/AffiliationsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Affiliations"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/affiliationsSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/promotionsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Promotions"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/promotionsSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/awardsAndDistinctionsButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Awards And Distinctions"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/awardsAndDistinctionsSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/otherButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/transparent"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Other"
                    android:textColor="#546878"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <View
                    android:id="@+id/otherSelectedIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:background="#4572CE"
                    android:visibility="invisible" />
            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/facilityGroupButtonsLayout"
        android:background="#DDE6F5" />

    <FrameLayout
        android:id="@+id/facilityGroupDetailsFragment"
        android:layout_below="@id/facilityGroupButtonsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
