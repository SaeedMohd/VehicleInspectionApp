<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Filter card — white panel on light page -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Row 1: Search fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/clubCodeTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Club Code"
                            android:textColor="#8A9BB0"
                            android:textSize="10sp"
                            android:layout_marginBottom="3dp" />
                        <EditText
                            android:id="@+id/clubCodeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/cert_input_background"
                            android:focusable="false"
                            android:gravity="center"
                            android:inputType="number"
                            android:lines="1"
                            android:textColor="#263238"
                            android:textColorHint="#8A9BB0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:id="@+id/visitationfacilityIdTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facility #"
                            android:textColor="#8A9BB0"
                            android:textSize="10sp"
                            android:layout_marginBottom="3dp" />
                        <EditText
                            android:id="@+id/visitationfacilityIdVal"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textColor="#263238"
                            android:textColorHint="#8A9BB0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Facility Name"
                            android:textColor="#8A9BB0"
                            android:textSize="10sp"
                            android:layout_marginBottom="3dp" />
                        <EditText
                            android:id="@+id/facilityNameButton"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/cert_input_background"
                            android:drawableEnd="@drawable/ic_arrow_dropdown"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="Select Facility"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="#263238"
                            android:textColorHint="#8A9BB0"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Specialist"
                            android:textColor="#8A9BB0"
                            android:textSize="10sp"
                            android:layout_marginBottom="3dp" />
                        <EditText
                            android:id="@+id/visitationSpecialistName"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:background="@drawable/cert_input_background"
                            android:drawableEnd="@drawable/ic_arrow_dropdown"
                            android:focusable="false"
                            android:gravity="center_vertical"
                            android:hint="Select"
                            android:lines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="#263238"
                            android:textColorHint="#8A9BB0"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E8EDF8" />

                <!-- Rows 2+3: STATUS/TYPE chips aligned column-by-column + Month/Year at end -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <!-- Chips area: both rows share the same width so columns align -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- STATUS row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="52dp"
                                android:layout_height="wrap_content"
                                android:text="STATUS"
                                android:textColor="#8A9BB0"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <CheckBox android:id="@+id/pendingCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Not Started" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/inProgressCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="In Progress" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/overdueCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Overdue" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/completedCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Completed" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                        </LinearLayout>

                        <!-- TYPE row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">

                            <TextView
                                android:layout_width="52dp"
                                android:layout_height="wrap_content"
                                android:text="TYPE"
                                android:textColor="#8A9BB0"
                                android:textSize="9sp"
                                android:textStyle="bold" />

                            <CheckBox android:id="@+id/annualVisitationCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Annual" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/adHocVisitationsCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Ad Hoc" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/deficienciesCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Deficiency" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                            <CheckBox android:id="@+id/quarterlyOrOtherVisistationsCheckBox"
                                android:layout_width="0dp" android:layout_height="26dp"
                                android:layout_weight="1" android:layout_marginStart="4dp"
                                android:button="@null" android:background="@drawable/chip_filter_selector"
                                android:checked="true" android:paddingStart="4dp" android:paddingEnd="4dp"
                                android:text="Quarterly" android:textColor="@color/chip_text_selector"
                                android:textSize="10sp" android:gravity="center" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Month + Year spinners aligned to trailing end -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginStart="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/visitationMonthTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Month"
                                android:textColor="#8A9BB0"
                                android:textSize="9sp"
                                android:layout_marginBottom="3dp" />
                            <Spinner
                                android:id="@+id/visitationMonthsSpinner"
                                android:layout_width="110dp"
                                android:layout_height="36dp"
                                android:background="@drawable/cert_input_background"
                                android:entries="@array/visitationMonthsFilter"
                                android:paddingStart="8dp"
                                android:popupBackground="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView
                                android:id="@+id/visitationYearTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Year"
                                android:textColor="#8A9BB0"
                                android:textSize="9sp"
                                android:layout_marginBottom="3dp" />
                            <Spinner
                                android:id="@+id/visitationYearFilterSpinner"
                                android:layout_width="80dp"
                                android:layout_height="36dp"
                                android:background="@drawable/cert_input_background"
                                android:paddingStart="8dp"
                                android:popupBackground="@color/white" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Separator -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="#E8EDF8" />

                <!-- Row 3: Options + Search -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <CheckBox
                        android:id="@+id/cityGroupCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Group By City"
                        android:textColor="#546878"
                        android:textSize="11sp"
                        app:buttonTint="@color/mainColor" />

                    <CheckBox
                        android:id="@+id/addAllCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:checked="false"
                        android:text="Add All to Today's Visitations"
                        android:textColor="#546878"
                        android:textSize="11sp"
                        app:buttonTint="@color/mainColor" />

                    <TextView
                        android:id="@+id/resultsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:visibility="gone"
                        android:textColor="#4572CE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:text="Filtered Visitations --> ()" />

                    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                    <Button
                        android:id="@+id/searchVisitaionsButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="Search"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Results list -->
        <ListView
            android:id="@+id/visitationfacilityListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:background="#EEF2FB"
            android:paddingTop="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- Loading overlay -->
    <RelativeLayout
        android:id="@+id/recordsProgressView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:clickable="true"
        android:visibility="visible">

        <ProgressBar
            android:id="@+id/progressBarRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:id="@+id/progressBarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecords"
            android:layout_centerHorizontal="true"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- PDF web card (hidden) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/webCardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:visibility="gone"
        app:cardCornerRadius="5dp"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp">

                <TextView
                    android:id="@+id/pdfName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/exitPDFDialogeBtn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/close" />

            </RelativeLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
