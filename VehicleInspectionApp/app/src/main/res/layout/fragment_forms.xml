<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:gravity="center_vertical"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--<ListView-->
    <!--android:id="@+id/formsListView"-->
    <!--android:layout_width="fill_parent"-->
    <!--android:layout_height="wrap_content"-->
    <!--android:dividerHeight="10dp"-->
    <!--android:background="@color/white"-->
    <!--&gt;-->
    <!--</ListView>-->

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/ll_1st"
        android:gravity="center"
        android:layout_centerHorizontal="true">

        <LinearLayout
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:id="@+id/visitationPlanningButton"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/calendar"
                android:layout_marginBottom="20dp"
                app:tint="@color/mainColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Visitation\nPlanning"
                android:textSize="18sp"
                android:textColor="@color/mainColor"
                android:layout_gravity="center"
                android:gravity="center" />


        </LinearLayout>


        <LinearLayout
            android:id="@+id/adHocVisitationButton"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:layout_marginLeft="100dp"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/todo"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="APP/Ad Hoc Visitation"
                android:textColor="@color/mainColor"
                android:textSize="18sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/applicantButton"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:visibility="gone"
            android:layout_marginStart="100dp"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/garage"
                android:layout_marginBottom="20dp"
                app:tint="@color/mainColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Applicant"
                android:textSize="18sp"
                android:textColor="@color/mainColor"
                android:layout_gravity="center"
                android:gravity="center"
                />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_below="@id/ll_1st"
        android:id="@+id/ll_2nd"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/pinnedVisitationButton"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:gravity="center_vertical"
            android:padding="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/day_calendar"
                android:layout_marginBottom="20dp"
                app:tint="@color/mainColor" />

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/todayVisitationTitle"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Today's \nVisitation"
                android:textColor="@color/mainColor"
                android:textSize="18sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/myPerformanceButton"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:visibility="gone"
            android:layout_marginLeft="50dp"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/speedometer"
                android:layout_marginBottom="20dp"
                app:tint="@color/mainColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My\nPerformance"
                android:textSize="26sp"
                android:textColor="@color/mainColor"
                android:layout_gravity="center"
                android:gravity="center" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/completedVisitationsButton"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:background="@drawable/big_button_background"
            android:visibility="visible"
            android:layout_marginLeft="100dp"
            android:gravity="center"
            android:padding="10dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/speedometer"
                android:layout_marginBottom="20dp"
                app:tint="@color/mainColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completed\nVisitations"
                android:textSize="18sp"
                android:textColor="@color/mainColor"
                android:layout_gravity="center"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>


</RelativeLayout>