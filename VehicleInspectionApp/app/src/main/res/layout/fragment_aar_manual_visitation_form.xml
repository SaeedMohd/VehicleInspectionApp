<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/generalInformationll"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/cert_header_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/generalInformationTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General Information"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@color/white">

                    <ProgressBar
                        android:id="@+id/progressbarGeneralInformation"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:max="100"
                        android:visibility="invisible"
                        android:indeterminateTint="#4572CE"
                        android:layout_marginTop="-7dp" />

                    <TextView
                        android:id="@+id/facilityIdTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Facility #:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/facilityIdEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#1A237E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/facilityNameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Facility Name:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/facilityNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/cert_input_background"
                        android:hint="Enter Facility Name"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />

                    <ListView
                        android:id="@+id/facilityNameListView"
                        android:layout_width="match_parent"
                        android:layout_height="400dp" />

                    <TextView
                        android:id="@+id/automotiveSpecialistTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Automotive Specialist:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/automotiveSpecialistEditText"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/cert_input_background"
                        android:hint="Enter Automotive Specialist Name"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/automotiveSpecialistSignature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Automotive Specialist's Signature:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/automotiveSpecialistSignatureButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_cert_outline"
                        android:text="CAPTURE SIGNATURE"
                        android:textColor="#4572CE"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/facilityRepresentativeNameTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Facility Representative's Name:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/facilityRepresentativeNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/cert_input_background"
                        android:hint="Enter Facility Representative's Name"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/facilityRepresentativeSignatureTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Facility Representative's Signature:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/afacilityRepresentativeSignatureButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_cert_outline"
                        android:text="CAPTURE SIGNATURE"
                        android:textColor="#4572CE"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                    <TextView
                        android:id="@+id/typeOfInspectionTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Type Of Inspection:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/inspectionTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/monthDueTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Month Due:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/monthDueSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/changesmadeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Changes Made:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/changesMadeSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/dateOfVisitationTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Date Of Visitation:"
                        android:textColor="#546878"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/dateOfVisitationButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/btn_cert_outline"
                        android:text="SELECT DATE"
                        android:textColor="#4572CE"
                        android:textSize="12sp"
                        app:backgroundTint="@null" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
