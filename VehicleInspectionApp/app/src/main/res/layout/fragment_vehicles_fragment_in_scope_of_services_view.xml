<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.inspection.fragments.FacilityGeneralInformationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Vehicle Type selector card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/highll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/cert_header_bg"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicles"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vehicle Type"
                            android:textColor="#546878"
                            android:textSize="13sp"
                            android:layout_marginEnd="12dp" />

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:background="@drawable/cert_input_background">

                            <Spinner
                                android:id="@+id/vehicleTypeSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Category cards -->
            <LinearLayout
                android:id="@+id/expandablell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Make - Asian -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/asianContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make - Asian"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/AsianVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Make - Domestic -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/domesticContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make - Domestic"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/DomesticVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Make - European -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/europeanContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make - European"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/EuropeanVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Make - Exotic -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/exoticContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make - Exotic"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/ExoticVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Other Types -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/otherContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Other Types"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/otherTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - CNG/LNG -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/CNGContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - CNG/LNG"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/cngCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/cngTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - Diesel -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/DieselContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - Diesel"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/dieselCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/dieselTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - Electric -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/ElectricContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - Electric"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/electricCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/electricTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - Gasoline -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/GasContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - Gasoline"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/gasCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/gasolineTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - Hybrid -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/HybridContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - Hybrid"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/hybridCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/hybridTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Fuel Type - Hydrogen -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/HydrogenContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/cert_header_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fuel Type - Hydrogen"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <CheckBox
                                android:id="@+id/hydrogenCheckBox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Check / Uncheck All"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                app:buttonTint="@color/checkbox_navy"
                                app:checkedIconTint="@color/white"
                                app:useMaterialThemeColors="false" />
                        </LinearLayout>

                        <com.inspection.Utils.ExpandableHeightGridView
                            android:id="@+id/hydrogenTypesVehiclesListView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:horizontalSpacing="2dp"
                            android:isScrollContainer="false"
                            android:numColumns="4"
                            android:padding="8dp"
                            android:stretchMode="columnWidth"
                            android:verticalSpacing="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Save / Cancel button row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_cert_primary"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/scopeOfServicesChangesDialogueLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="#4572CE"
                    app:trackColor="#EEF2FB"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/progressBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="#1A237E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</RelativeLayout>
