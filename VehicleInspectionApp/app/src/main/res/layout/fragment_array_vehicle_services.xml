<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.inspection.fragments.FacilityGeneralInformationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Automobile card -->
            <LinearLayout
                android:id="@+id/first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Card header -->
                <LinearLayout
                    android:id="@+id/autoMobilell"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Automobile"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Gasoline section -->
                <RelativeLayout
                    android:id="@+id/gasll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileGasolineTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Gasoline"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/gasCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/gasolineServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Hybrid section -->
                <RelativeLayout
                    android:id="@+id/hybridll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileHybridTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Hybrid"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/hybridCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/hybridServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Diesel section -->
                <RelativeLayout
                    android:id="@+id/dieselll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileDieselTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Diesel"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/dieselCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/dieselServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Electric section -->
                <RelativeLayout
                    android:id="@+id/electricll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileElectricTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Electric"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/electricCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/electricServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Hydrogen section -->
                <RelativeLayout
                    android:id="@+id/hydrogenll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileHydrogenTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Hydrogen"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/hydrogenCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/hydrogenServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- CNG/LNG section -->
                <RelativeLayout
                    android:id="@+id/cngll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EEF4FB"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/autoMobileCNGTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="CNG/LNG"
                        android:textColor="#1A237E"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <CheckBox
                        android:id="@+id/cngCheckBox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Check / Uncheck All"
                        android:textColor="#1A237E"
                        android:textSize="13sp"
                        app:buttonTint="@drawable/checkbox_bkg" />
                </RelativeLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/cngServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />

                <!-- Hidden grid (kept for code compatibility) -->
                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/vehicleServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="5"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Separator (kept for ID compatibility) -->
            <View
                android:id="@+id/second"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Auto Body card -->
            <LinearLayout
                android:id="@+id/third"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Body"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/languagesGridView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="4"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />
            </LinearLayout>

            <!-- Separator (kept for ID compatibility) -->
            <View
                android:id="@+id/fourth"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- Marine card -->
            <LinearLayout
                android:id="@+id/fifth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Marine"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/MarineServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="4"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />
            </LinearLayout>

            <!-- Separator (kept for ID compatibility) -->
            <View
                android:id="@+id/sixth"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!-- RV card -->
            <LinearLayout
                android:id="@+id/seventh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RV"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.inspection.Utils.ExpandableHeightGridView
                    android:id="@+id/RecreationalServicesListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    android:gravity="center"
                    android:horizontalSpacing="2dp"
                    android:isScrollContainer="false"
                    android:numColumns="4"
                    android:stretchMode="columnWidth"
                    android:verticalSpacing="12dp" />
            </LinearLayout>

            <!-- Cancel / Save action row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/white"
                android:elevation="4dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_outline"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Cancel"
                    android:textColor="#1565C0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/btn_cert_primary"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading overlay -->
    <RelativeLayout
        android:id="@+id/scopeOfServicesChangesDialogueLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:clickable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBarRecordsVS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:id="@+id/progressBarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecordsVS"
            android:layout_centerHorizontal="true"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

</RelativeLayout>
