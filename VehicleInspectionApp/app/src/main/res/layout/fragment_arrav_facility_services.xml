<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.inspection.fragments.FacilityGeneralInformationFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Facility Services card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Header -->
                <RelativeLayout
                    android:id="@+id/subTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Facility Services"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/showNewserviceDialogueButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@color/white"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Add New Facility Service"
                        android:textAllCaps="false"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </RelativeLayout>

                <!-- Services table -->
                <TableLayout
                    android:id="@+id/aarPortalTrackingTableLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:showDividers="middle"
                    android:shrinkColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="36dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="3"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Service"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Effective Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Expiration Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:layout_weight="3"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Comments"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Options"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay for dialogs -->
    <View
        android:id="@+id/alphaBackgroundForFC_ServicesDialogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:visibility="gone" />

    <!-- Add New Facility Service dialog -->
    <ScrollView
        android:id="@+id/facilityServicesCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/addFacilityServicesDialogeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Add New Facility Service"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/exitFC_ServicesDialogeBtnId"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_close_x"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- Service label -->
                <TextView
                    android:id="@+id/fcServiceSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Service *"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <!-- Service spinner -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">

                    <Spinner
                        android:id="@+id/fc_services_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </RelativeLayout>

                <!-- Effective + Expiration date row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Effective Date *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/fceffective_date_textviewVal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Expiration Date"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/fcexpiration_date_textviewVal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/comments_editTextVal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="top|start"
                    android:lines="4"
                    android:minHeight="80dp"
                    android:padding="12dp"
                    android:textColor="#1A237E"
                    android:textSize="14sp" />

                <!-- Submit button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                    <Button
                        android:id="@+id/submitNewserviceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Edit Facility Service dialog -->
    <ScrollView
        android:id="@+id/editFacilityServicesCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/editFacilityServicesDialogeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Update Facility Service"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/edit_exitFC_ServicesDialogeBtnId"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_close_x"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <!-- Service label -->
                <TextView
                    android:id="@+id/edit_fcServiceSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Service *"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <!-- Service spinner -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">

                    <Spinner
                        android:id="@+id/edit_fc_services_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                </RelativeLayout>

                <!-- Effective + Expiration date row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Effective Date *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/edit_fceffective_date_textviewVal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Expiration Date"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/edit_fcexpiration_date_textviewVal"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textAllCaps="false"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            app:backgroundTint="@null" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/edit_comments_editTextVal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="top|start"
                    android:lines="4"
                    android:minHeight="80dp"
                    android:padding="12dp"
                    android:textColor="#1A237E"
                    android:textSize="14sp" />

                <!-- Submit button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                    <Button
                        android:id="@+id/edit_submitNewserviceButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:text="Submit"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/FC_LoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="#4572CE"
                    app:trackColor="#EEF2FB"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/progressBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Loading..."
                    android:textColor="#1A237E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</RelativeLayout>
