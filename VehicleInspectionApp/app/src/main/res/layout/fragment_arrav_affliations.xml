<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context="com.inspection.fragments.FragmentARRAVAffiliations">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Affiliations card -->
            <LinearLayout
                android:id="@+id/mainViewLinearId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Affiliations"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/addNewAffil"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@color/white"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Add New Affiliation"
                        android:textAllCaps="false"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </RelativeLayout>

                <!-- Table -->
                <TableLayout
                    android:id="@+id/mainAffTableLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:divider="@drawable/divider_table_layout"
                    android:showDividers="middle"
                    android:shrinkColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="36dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Affiliation Type"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="1.5"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Affiliation Details"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="0.8"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Effective Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:layout_weight="0.8"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Expiration Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_weight="2"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Comments"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="5"
                            android:layout_weight="0.6"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Options"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>

                </TableLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay -->
    <View
        android:id="@+id/alphaBackgroundForAffilliationsDialogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:visibility="gone" />

    <!-- Add New Affiliation dialog -->
    <ScrollView
        android:id="@+id/affiliationsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Add New Affiliation"
                        android:textColor="#1A237E"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/exitAffDialogeBtnId"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <!-- Affiliation Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Affiliation Type *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/affiliations_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Affiliation Type Detail -->
                <TextView
                    android:id="@+id/afDetails_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Affiliation Type Detail *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/afDetails_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Effective Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Effective Date *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/afDtlseffective_date_textviewVal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Expiration Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Expiration Date"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/afDtlsexpiration_date_textviewVal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/affcomments_editTextVal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxEms="250"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <!-- Submit -->
                <Button
                    android:id="@+id/submitNewAffil"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_primary"
                    android:text="SUBMIT"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Edit Affiliation dialog -->
    <ScrollView
        android:id="@+id/edit_affiliationsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:id="@+id/edit_addAfiliationsDialogeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Update Affiliation"
                        android:textColor="#1A237E"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                    <ImageButton
                        android:id="@+id/edit_exitAffDialogeBtnId"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <!-- Affiliation Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Affiliation Type *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/edit_affiliations_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Affiliation Type Detail -->
                <TextView
                    android:id="@+id/edit_afDetails_textview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Affiliation Type Detail *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background">
                    <Spinner
                        android:id="@+id/edit_afDetails_textviewVal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:popupBackground="@drawable/spinner_popup_bg"
                        android:paddingStart="10dp"
                        android:paddingEnd="28dp" />
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        android:contentDescription=""
                        android:src="@drawable/ic_arrow_dropdown" />
                </RelativeLayout>

                <!-- Effective Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Effective Date *"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/edit_afDtlseffective_date_textviewVal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Expiration Date -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Expiration Date"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/edit_afDtlsexpiration_date_textviewVal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="SELECT DATE"
                    android:textAllCaps="false"
                    android:textColor="#4572CE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments"
                    android:textColor="#546878"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <EditText
                    android:id="@+id/edit_affcomments_editTextVal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/cert_input_background"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:maxEms="250"
                    android:padding="10dp"
                    android:textSize="14sp" />

                <!-- Submit -->
                <Button
                    android:id="@+id/edit_submitNewAffil"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/btn_cert_primary"
                    android:text="SUBMIT"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Loading overlay -->
    <RelativeLayout
        android:id="@+id/affLoadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:clickable="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBarRecordsAff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:id="@+id/progressBarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecordsAff"
            android:layout_centerHorizontal="true"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>
