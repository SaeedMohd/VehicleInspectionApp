<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"

    android:background="@color/light_gray"
    tools:context=".fragments.TodayVisitationFragment">
    <RelativeLayout
        android:id="@+id/recordsProgressView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:elevation="30dp"
        android:clickable="true"
        android:background="@color/mainColor"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressBarRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:progressTint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/progressBarRecords"
            android:id="@+id/progressBarText"
            android:layout_centerHorizontal="true"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />


    </RelativeLayout>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:id="@+id/topSavedll"
            android:background="@color/white"
            app:cardCornerRadius="5dp"
            app:cardElevation="10dp"
            android:layout_height="wrap_content">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:layout_alignParentTop="true"
                    android:layout_gravity="center_vertical"
                    android:stretchColumns="2"
                    android:layout_marginEnd="5dp"
                    >
                    <TableRow android:layout_marginTop="5dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_column="0"
                            android:gravity="center"
                            android:elevation="10dp"
                            android:padding="10dp"
                            android:background="@drawable/dashboard_border"
                            android:layout_gravity="center_vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Planned Visitations"
                            android:layout_column="0"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:layout_margin="5dp"
                            android:textColor="@color/darkBlue" />

                        <TextView
                            android:id="@+id/plannedVal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_red_dark"
                            android:layout_column="1"
                            android:layout_margin="5dp"
                            android:text="test" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:elevation="10dp"
                            android:layout_marginStart="20dp"
                            android:layout_column="1"
                            android:padding="10dp"
                            android:gravity="center"
                            android:background="@drawable/dashboard_border"
                            android:layout_gravity="center_vertical">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Completed Visitations"
                                android:layout_column="0"
                                android:textStyle="bold"
                                android:gravity="center"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:layout_margin="5dp"
                                android:textColor="@color/darkBlue" />

                            <TextView
                                android:id="@+id/completedVal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#26C3AA"
                                android:layout_column="1"
                                android:layout_margin="5dp"
                                android:text="test" />
                        </LinearLayout>
                        <Button
                            android:layout_width="wrap_content"
                            android:padding="10dp"
                            android:background="@drawable/new_btn_bkg"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            app:backgroundTint="@null"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_gravity="center_vertical"
                            android:text="Reload Saved Visitations"
                            android:id="@+id/reloadBtn"
                            />
                        <Button
                            android:layout_width="wrap_content"
                            android:padding="10dp"
                            android:background="@drawable/new_btn_bkg"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            app:backgroundTint="@null"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:layout_gravity="center_vertical"
                            android:text="Clear Saved Visitations"
                            android:id="@+id/clearBtn"
                            />
                    </TableRow>
                </TableLayout>
