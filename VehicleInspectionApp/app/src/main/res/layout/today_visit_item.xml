<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listBkg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardRL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- ================= ORDER CIRCLE ================= -->

        <TextView
            android:id="@+id/orderCircle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_drawable"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ================= STATUS BADGE ================= -->

        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="Planned"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/orderCircle"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ================= FACILITY NAME ================= -->

        <TextView
            android:id="@+id/facNameVal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/mainColor"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAlignment="center"
            app:layout_constraintEnd_toStartOf="@id/statusBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ================= LEFT COLUMN ================= -->

        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@id/rightColumn"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/facNameVal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Facility Number:"
                android:textColor="@color/mainColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/facNoVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City:"
                android:textColor="@color/mainColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cityVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type:"
                android:textColor="@color/mainColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/typeVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= RIGHT COLUMN ================= -->

        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/leftColumn"
            app:layout_constraintTop_toBottomOf="@id/facNameVal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club Code:"
                android:textColor="@color/mainColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/clubNoVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Facility Annual Month:"
                android:textColor="@color/mainColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/facAnnualMonthVal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= ETA ROW ================= -->

        <LinearLayout
            android:id="@+id/etaRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rightColumn">

            <TextView
                android:id="@+id/etaLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mainColor"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= LOCATION ROW ================= -->

        <LinearLayout
            android:id="@+id/locFoundRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etaRow">

            <TextView
                android:id="@+id/locFoundLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* Location Available"
                android:textColor="@color/mainColor"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= NOTES ================= -->

        <LinearLayout
            android:id="@+id/notesContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/locFoundRow">

            <EditText
                android:id="@+id/notesVal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="5"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/recordBtn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/mic_icon" />

            <ImageButton
                android:id="@+id/stopBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/hangup_call"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================= PRIMARY ACTION ROW (icon + label) ================= -->

        <LinearLayout
            android:id="@+id/buttonRow1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notesContainer">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveNotesBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save Notes"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/mainColor"
                app:icon="@drawable/save_button"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/removeBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Remove"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/mainColor"
                app:icon="@drawable/delete_button"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/loadBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Load Facility"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/mainColor"
                app:icon="@drawable/maintenance_facility_icon"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- ================= MOVE BUTTONS ROW (icon-only) ================= -->

        <LinearLayout
            android:id="@+id/buttonRow2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/buttonRow1">

            <ImageButton
                android:id="@+id/moveFirstBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_move_first"
                android:background="@drawable/new_btn_bkg"
                android:contentDescription="Move to first position"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/moveUpBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_move_up"
                android:background="@drawable/new_btn_bkg"
                android:contentDescription="Move up one position"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/moveDownBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_move_down"
                android:background="@drawable/new_btn_bkg"
                android:contentDescription="Move down one position"
                app:backgroundTint="@null" />

            <ImageButton
                android:id="@+id/moveLastBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_move_last"
                android:background="@drawable/new_btn_bkg"
                android:contentDescription="Move to last position"
                app:backgroundTint="@null" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
