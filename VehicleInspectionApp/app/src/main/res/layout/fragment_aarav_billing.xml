<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF"
    tools:context=".fragments.FragmentAARAVBilling">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Billing card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <!-- Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_header_bg"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/BillingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Billing"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/addNewBillingBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@color/white"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="+ Add Billing"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </RelativeLayout>

                <!-- Billing table -->
                <TableLayout
                    android:id="@+id/billingResultsTbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="8dp"
                    android:shrinkColumns="*">

                    <TableRow
                        android:background="@drawable/cert_header_bg"
                        android:minHeight="36dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="0"
                            android:layout_weight="0.4"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Bill ID #"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Revenue Source"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:layout_weight="0.6"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Billing Month"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Billing Due Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Billing Amount"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="5"
                            android:layout_weight="0.7"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Payment Amount"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_column="6"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="Payment Received Date"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Dim overlay -->
    <View
        android:id="@+id/alphaBackgroundForDialogs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:background="@color/mainColor"
        android:visibility="gone" />

    <!-- Add New Billing dialog -->
    <ScrollView
        android:id="@+id/addNewBillingDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Dialog header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Add New Billing"
                        android:textColor="#1A237E"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/billingSubmitButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="36dp"
                        android:background="@drawable/btn_cert_primary"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Submit"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/exitDialogeBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/close"
                        android:contentDescription="Close" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="16dp"
                    android:background="#E0E0E0" />

                <!-- Bill ID + Revenue Source -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Bill ID"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newBillIDText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Revenue Source"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background">

                            <Spinner
                                android:id="@+id/newRevSourceSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:entries="@array/contractTypesEntries"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />
                        </RelativeLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Billing Month + Billing Due Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Billing Month *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background">

                            <Spinner
                                android:id="@+id/newBillMonthSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:entries="@array/contractTypesEntries"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Billing Due Date *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newBillDueDateBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2nd Due Date + Final Due Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="2nd Billing Due Date"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newSecondDueDateText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Final Billing Due Date"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newFinalDueDateText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Billing Amount + ACH Discount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Billing Amount *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newBillingAmountText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="ACH Discount Amount"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newACHDiscountText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ACH Date + Payment Received Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Date ACH File Sent To Cashier"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newACHDateBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Payment Received Date *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newPayRecDateBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Payment Amount + Pending Amount -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Payment Amount *"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newPayAmountText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Pending Amount"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newPendingAmountText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Credit Amount Due + Credit Applied Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Credit Amount Due"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newCreditAmtDueText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Credit Applied Date"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/newCreditAppliedDateBtn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:text="SELECT DATE"
                            android:textColor="#1565C0"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Credit Description -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Credit Description"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/newCreditDescText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="top|start"
                    android:lines="3"
                    android:minHeight="60dp"
                    android:padding="12dp"
                    android:textColor="#1A237E"
                    android:textSize="14sp" />

                <!-- On Payment Plan + Number of Payments -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="On Payment Plan"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newOnPaymentPlanText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="Number of Payments"
                            android:textColor="#546878"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/newNoOfPaymentText"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/cert_input_background"
                            android:gravity="center_vertical|start"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="#1A237E"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Payment Plan Amount Remaining -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Payment Plan Amount Remaining"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/newPayPlanAmntRem"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/cert_input_background"
                    android:gravity="center_vertical|start"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#1A237E"
                    android:textSize="14sp" />

                <!-- Comments -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Comments *"
                    android:textColor="#546878"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/newComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cert_input_background"
                    android:gravity="top|start"
                    android:lines="4"
                    android:minHeight="80dp"
                    android:padding="12dp"
                    android:textColor="#1A237E"
